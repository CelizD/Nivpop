# Copy this file to .env.local and fill in your values.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── EmailJS (para enviar resultado por correo) ────────────────────────────────
# Free account at https://emailjs.com
# Template variables available: to_email, customer_name, flavor_name,
#   persona, insight, description, folio, date
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
